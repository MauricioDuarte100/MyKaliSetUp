# ==============================================================================
# 🛡️ I3 CONFIGURATION (v4) - KALI CYBER ENVIRONMENT
# ==============================================================================

set $mod Mod4

# ==============================================================================
# VARIABLES Y COLORES
# ==============================================================================

# Fuente para los títulos de ventana y la barra
font pango:RobotoMono Nerd Font, Iosevka Nerd Font, monospace 9

# Paleta de Colores Cyber Dark
set $bg-color            #0f141c
set $inactive-bg-color   #161b22
set $text-color          #e6edf3
set $inactive-text-color #7d8590
set $urgent-bg-color     #ff7b72
set $focused-border      #58a6ff

# Colores de Ventana
#                       borde            fondo            texto            indicador
client.focused          $focused-border  #1f242c          $text-color      $focused-border
client.focused_inactive $inactive-bg-color $inactive-bg-color $inactive-text-color $inactive-bg-color
client.unfocused        #0d1117          #0d1117          $inactive-text-color #0d1117
client.urgent           $urgent-bg-color $urgent-bg-color #ffffff          $urgent-bg-color
client.placeholder      #0d1117          #0d1117          $text-color      #0d1117

client.background       $bg-color

# ==============================================================================
# CONFIGURACIÓN GENERAL
# ==============================================================================

# Mouse+$mod para arrastrar ventanas flotantes
floating_modifier $mod

# Espaciado (Gaps)
gaps inner 8
gaps outer 4
smart_gaps on

# Bordes
for_window [class="^.*"] border pixel 2
default_border pixel 2
default_floating_border pixel 2

# ==============================================================================
# ESPACIOS DE TRABAJO (WORKSPACES)
# ==============================================================================

set $ws1 "1:Terminals"
set $ws2 "2:Web"
set $ws3 "3:Proxies"
set $ws4 "4:Reverse"
set $ws5 "5:Notes"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Cambiar a espacio de trabajo
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Mover ventana a espacio de trabajo
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# Asignación automática de aplicaciones a Workspaces
assign [class="(?i)firefox"] $ws2
assign [class="(?i)chromium"] $ws2
assign [class="(?i)burp"] $ws3
assign [class="(?i)wireshark"] $ws3
assign [class="(?i)ghidra"] $ws4
assign [class="(?i)ida"] $ws4
assign [class="(?i)binary ninja"] $ws4
assign [class="(?i)obsidian"] $ws5
assign [class="(?i)cherrytree"] $ws5

# ==============================================================================
# ATAJOS DE TECLADO (KEYBINDINGS)
# ==============================================================================

# --- Aplicaciones y Terminales ---
# Abrir terminal Alacritty
bindsym $mod+Return exec --no-startup-id alacritty
# Terminal flotante Scratchpad
bindsym $mod+u exec --no-startup-id ~/.config/i3/scripts/scratchpad.sh
# Lanzador de comandos Rofi
bindsym $mod+d exec --no-startup-id rofi -show run
# Lanzador de aplicaciones Rofi
bindsym $mod+Shift+d exec --no-startup-id rofi -show drun
# Abrir navegador Firefox
bindsym $mod+w exec --no-startup-id firefox
# Abrir gestor de archivos Thunar
bindsym $mod+f exec --no-startup-id thunar

# --- Ciberseguridad & CTF ---
# Copiar Target IP al portapapeles
bindsym $mod+c exec --no-startup-id ~/.config/i3/scripts/copy_target.sh
# Fijar Target IP (Prompt Rofi)
bindsym $mod+Shift+t exec --no-startup-id ~/.config/i3/scripts/set_target.sh
# Limpiar Target IP
bindsym $mod+Shift+x exec --no-startup-id ~/.config/i3/scripts/set_target.sh --clear
# Abrir Burp Suite
bindsym $mod+Shift+b exec --no-startup-id burpsuite
# Abrir Wireshark
bindsym $mod+Shift+w exec --no-startup-id wireshark

# --- Sistema y Sesión ---
# Cerrar ventana enfocada
bindsym $mod+Shift+q kill
# Recargar configuración de i3
bindsym $mod+Shift+c reload
# Reiniciar i3wm
bindsym $mod+Shift+r restart
# Menú de Apagado / Salida
bindsym $mod+Shift+e exec --no-startup-id ~/.config/i3/scripts/powermenu.sh
# Bloquear pantalla
bindsym $mod+Shift+Escape exec --no-startup-id i3lock -c 0f141c

# --- Capturas de Pantalla ---
# Captura de pantalla interactiva
bindsym $mod+P exec --no-startup-id flameshot gui
# Captura de pantalla completa
bindsym Print exec --no-startup-id flameshot full -p ~/Pictures/Screenshots

# --- Multimedia y Volumen ---
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# --- Brillo de Pantalla (Brightnessctl / Xbacklight) ---
bindsym XF86MonBrightnessUp exec --no-startup-id sh -c "brightnessctl set +10% 2>/dev/null || xbacklight -inc 10"
bindsym XF86MonBrightnessDown exec --no-startup-id sh -c "brightnessctl set 10%- 2>/dev/null || xbacklight -dec 10"

# --- Foco de Ventana (Vim + Flechas) ---
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Movimiento de Ventana ---
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Manipulación de Diseño (Layout) ---
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# --- Modo Redimensionar ---
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# REGLAS DE VENTANA Y SCRATCHPAD
# ==============================================================================

# Reglas generales para ventanas flotantes
for_window [class="Pavucontrol"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Nitrogen"] floating enable
for_window [class="Flameshot"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# Regla de Scratchpad Dropdown Terminal
for_window [instance="scratchpad"] floating enable, resize set 1100 650, move position center, move scratchpad, border pixel 2

# ==============================================================================
# INICIO AUTOMÁTICO (STARTUP)
# ==============================================================================

# Fondo de pantalla
exec_always --no-startup-id sh ~/.fehbg

# Compositor (Transparencias y sombras modernas)
exec_always --no-startup-id sh -c "killall -q picom 2>/dev/null; picom -b --config ~/.config/picom/picom.conf"

# Gestor de Portapapeles para VMs (VMware, VirtualBox, KVM)
exec_always --no-startup-id ~/.config/i3/clipboard_fix.sh

# Demonio de Notificaciones Dunst
exec_always --no-startup-id command -v dunst >/dev/null 2>&1 && dunst &

# Ocultar cursor inactivo
exec_always --no-startup-id unclutter -idle 3 &

# ==============================================================================
# BARRA DE ESTADO (STATUS BAR)
# ==============================================================================

bar {
    status_command i3blocks -c ~/.config/i3/i3blocks.conf
    i3bar_command i3bar -t
    position top
    height 28
    font pango:RobotoMono Nerd Font, Iosevka Nerd Font, monospace 10
    strip_workspace_numbers no
    
    colors {
        background $bg-color
        separator #484f58
        #                  borde              fondo              texto
        focused_workspace  $focused-border    $inactive-bg-color $text-color
        inactive_workspace $inactive-bg-color $bg-color          $inactive-text-color
        urgent_workspace   $urgent-bg-color   $urgent-bg-color   #ffffff
    }
}
